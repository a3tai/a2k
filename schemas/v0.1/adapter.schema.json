{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a3t.ai/a2k/schemas/v0.1/adapter.schema.json",
  "title": "A2K adapter descriptor",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "a2k.a3t.ai/v0alpha1" },
    "kind": { "const": "AdapterDescriptor" },
    "metadata": {
      "type": "object",
      "required": ["id", "name", "owner"],
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "owner": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["standard", "operations", "mapping"],
      "properties": {
        "standard": {
          "type": "object",
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "format": "uri" },
            "version": { "type": "string", "minLength": 1, "maxLength": 100 }
          },
          "additionalProperties": false
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["discover", "read", "propose"] }
        },
        "mapping": {
          "type": "object",
          "required": ["preserved", "synthesized", "omitted"],
          "properties": {
            "preserved": { "type": "array", "items": { "type": "string" } },
            "synthesized": { "type": "array", "items": { "type": "string" } },
            "omitted": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
