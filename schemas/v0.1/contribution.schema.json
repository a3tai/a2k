{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a3t.ai/a2k/schemas/v0.1/contribution.schema.json",
  "title": "A2K knowledge contribution proposal",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "a2k.a3t.ai/v0alpha1" },
    "kind": { "const": "Contribution" },
    "metadata": {
      "type": "object",
      "required": ["id", "proposedBy", "createdAt", "status"],
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "proposedBy": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["draft", "review", "changes-requested", "approved", "rejected", "withdrawn"] }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["operation", "targetId", "classification", "rationale", "reviewers"],
      "properties": {
        "operation": { "enum": ["create", "amend", "supersede", "invalidate", "archive", "restore", "link"] },
        "targetId": { "type": "string", "format": "uri" },
        "baseRevision": { "type": "string", "minLength": 1, "maxLength": 200 },
        "baseDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidence": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "format": "uri" }
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        },
        "decision": {
          "type": "object",
          "required": ["outcome", "decidedBy", "decidedAt"],
          "properties": {
            "outcome": { "enum": ["approved", "rejected", "changes-requested"] },
            "decidedBy": { "type": "string", "format": "uri" },
            "decidedAt": { "type": "string", "format": "date-time" },
            "reason": { "type": "string", "maxLength": 4000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
