{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a3t.ai/a2k/schemas/v0.1/manifest.schema.json",
  "title": "A2K bootstrap manifest",
  "description": "Draft schema for an A2K organization hub, private overlay, or project bootstrap.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "apiVersion": { "const": "a2k.a3t.ai/v0alpha1" },
    "kind": {
      "enum": ["OrganizationHub", "PrivateOverlay", "ProjectBootstrap"]
    },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9.-]*$": { "$ref": "#/$defs/extensionValue" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "PrivateOverlay" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "spec": {
            "type": "object",
            "required": ["overlay"],
            "properties": { "overlay": true }
          }
        }
      }
    }
  ],
  "$defs": {
    "classification": {
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "metadata": {
      "type": "object",
      "required": ["id", "name", "owners", "classification"],
      "properties": {
        "id": { "type": "string", "format": "uri", "maxLength": 2048 },
        "name": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "owners": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "maxLength": 2048 }
        },
        "classification": { "$ref": "#/$defs/classification" }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": { "$ref": "#/$defs/extensionValue" }
      },
      "additionalProperties": false
    },
    "root": {
      "type": "object",
      "required": ["id", "path", "classification"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "path": { "$ref": "#/$defs/relativePath" },
        "classification": { "$ref": "#/$defs/classification" },
        "kinds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": ["id", "type", "uri", "classification"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "type": {
          "enum": [
            "documentation",
            "catalog",
            "knowledge-base",
            "schema",
            "tooling",
            "research"
          ]
        },
        "uri": { "type": "string", "format": "uri", "maxLength": 2048 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 200 },
        "digest": { "$ref": "#/$defs/digest" },
        "classification": { "$ref": "#/$defs/classification" }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["remoteFetch", "mutation"],
      "properties": {
        "remoteFetch": { "enum": ["disabled", "allowlisted"] },
        "mutation": { "enum": ["deny", "proposal", "approval-required"] }
      },
      "additionalProperties": false
    },
    "overlay": {
      "type": "object",
      "required": ["baseId", "baseDigest"],
      "properties": {
        "baseId": { "type": "string", "format": "uri", "maxLength": 2048 },
        "baseDigest": { "$ref": "#/$defs/digest" },
        "baseRevision": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["roots", "profiles", "policy"],
      "properties": {
        "roots": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/root" }
        },
        "references": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/reference" }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "enum": [
                  "core",
                  "governance",
                  "bootstrap",
                  "mcp",
                  "identity",
                  "knowledge-adapters",
                  "a2a",
                  "acp",
                  "agent-skills"
                ]
              },
              { "type": "string", "pattern": "^x-[a-z0-9][a-z0-9.-]*$" }
            ]
          }
        },
        "policy": { "$ref": "#/$defs/policy" },
        "overlay": { "$ref": "#/$defs/overlay" }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": { "$ref": "#/$defs/extensionValue" }
      },
      "additionalProperties": false
    },
    "extensionValue": {
      "anyOf": [
        { "type": "string", "maxLength": 512 },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    }
  }
}
